# TeleVault backend configuration
# Copy this file to backend/.env and fill in your own values.
# NEVER commit .env or any file under backend/data/.

NODE_ENV=development
HOST=127.0.0.1
PORT=4787
DATA_DIR=./data

LOG_LEVEL=info
LOG_PRETTY=true

# Telegram API credentials from https://my.telegram.org
# Both values are required to enable Telegram. Never commit them.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CONNECT_TIMEOUT_MS=20000

# Optional local API token (minimum 32 characters).
# If omitted, TeleVault generates one at backend/data/api-token on first start.
# Send it as the X-Televault-Token header. Never put it in source control.
TELEVAULT_API_TOKEN=

# Optional AES-256 master key, base64-encoded (exactly 32 bytes).
# If omitted, TeleVault generates backend/data/master.key with owner-only perms.
# This key encrypts the Telegram session string at rest. Back it up carefully:
# losing it means the saved Telegram session cannot be decrypted.
TELEVAULT_MASTER_KEY=

# Comma-separated extra browser origins allowed by CORS.
# localhost / 127.0.0.1 / [::1] origins are always allowed.
ALLOWED_ORIGINS=

# Packaged Electron apps may send Origin: null. Enable only if you need it.
ALLOW_NULL_ORIGIN=false
