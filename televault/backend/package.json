{
  "name": "televault-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TeleVault local-first backend: Telegram-backed personal cloud storage",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/backend/src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/backend/src/server.js",
    "db:migrate": "tsx src/database/migrate-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@types/busboy": "^1.5.5",
    "better-sqlite3": "^13.1.1",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
